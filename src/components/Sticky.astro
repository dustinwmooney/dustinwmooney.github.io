---
// Scrollytelling primitive: a media panel that pins while the narration
// scrolls past it (Snow Fall / SBS The Boat pattern, CSS-only).
interface Props { src: string; alt?: string; video?: boolean }
const { src, alt = '', video = false } = Astro.props;
---
<section class="scrolly">
  <div class="media">
    {video ? <video src={src} autoplay muted loop playsinline /> : <img src={src} alt={alt} loading="lazy" />}
  </div>
  <div class="steps"><slot /></div>
</section>
<style>
  .scrolly {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin: 3rem calc(50% - 50vw);
    padding: 0 4vw;
  }
  .media { position: relative; }
  .media img, .media video {
    position: sticky;
    top: 10vh;
    width: 100%;
    max-height: 80vh;
    object-fit: cover;
  }
  .steps { font-family: var(--serif); font-size: 1.1rem; }
  .steps :global(p) {
    min-height: 55vh;
    display: flex;
    align-items: center;
    background: var(--bg);
    padding: 1rem 0;
  }
  @media (max-width: 720px) {
    .scrolly { grid-template-columns: 1fr; }
    .media img, .media video { position: relative; top: 0; max-height: 45vh; }
    .steps :global(p) { min-height: auto; }
  }
</style>
