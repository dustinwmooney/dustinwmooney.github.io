---
// Base layout: icon rail on desktop (Stamatiou-style), top bar on mobile.
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = 'Dustin Mooney — customer success and strategy leader. Writing on work, technology, and building things.',
  ogType = 'website',
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const at = (p: string) => (p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dustin Mooney',
  url: 'https://dustinwmooney.github.io',
  sameAs: ['https://linkedin.com/in/dustinmooney'],
  jobTitle: 'Solutions Strategist',
  worksFor: { '@type': 'Organization', name: 'General Motors' },
};

const nav = [
  { href: '/', label: 'Home', icon: 'M3 11.5 12 4l9 7.5M5.5 9.5V20h13V9.5' },
  { href: '/writing/', label: 'Writing', icon: 'M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17v3ZM14 7l3 3' },
  { href: '/about/', label: 'About', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0' },
  { href: '/resume/', label: 'Resume', icon: 'M7 3h7l4 4v14H7V3Zm7 0v4h4M10 12h5M10 16h5' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Dustin Mooney — Writing" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? person)} />
    <script is:inline>
      // Theme, applied before paint. Explicit choice wins; the site defaults
      // to DARK otherwise (Dustin, 2026-07-12) — OS preference no longer read.
      (function () {
        const mode = localStorage.getItem('theme') ?? 'dark';
        document.documentElement.dataset.theme = mode;
        document.documentElement.classList.toggle('dark-active', mode === 'dark');
      })();
      function toggleTheme() {
        const dark = !document.documentElement.classList.contains('dark-active');
        const mode = dark ? 'dark' : 'light';
        document.documentElement.dataset.theme = mode;
        document.documentElement.classList.toggle('dark-active', dark);
        localStorage.setItem('theme', mode);
        dispatchEvent(new CustomEvent('themechange'));
      }
    </script>
  </head>
  <body>
    <aside class="rail" aria-label="Site navigation">
      {nav.map((n) => (
        <a href={n.href} aria-current={at(n.href)} title={n.label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={n.icon} />
          </svg>
          <span class="sr">{n.label}</span>
        </a>
      ))}
      <button class="search-open" onclick="openSearch()" title="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4" />
        </svg>
        <span class="sr">Search</span>
      </button>
      <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 13A8 8 0 1 1 11 4a6.5 6.5 0 0 0 9 9Z" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M4.7 4.7l1.8 1.8M17.5 17.5l1.8 1.8M19.3 4.7l-1.8 1.8M6.5 17.5l-1.8 1.8" />
        </svg>
        <span class="sr">Toggle theme</span>
      </button>
    </aside>
    <div class="wrap">
      <nav class="site-nav">
        <a class="brand" href="/">
          <img class="mark" src="/logo-mark.png" alt="" width="96" height="71" />
          <span>Dustin Mooney</span>
        </a>
        <a href="/writing/" aria-current={at('/writing/')}>Writing</a>
        <a href="/about/" aria-current={at('/about/')}>About</a>
        <a href="/resume/" aria-current={at('/resume/')}>Resume</a>
        <button class="search-open nav-toggle" onclick="openSearch()" title="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4" />
          </svg>
          <span class="sr">Search</span>
        </button>
        <button class="theme-toggle nav-toggle" onclick="toggleTheme()" title="Toggle theme">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 13A8 8 0 1 1 11 4a6.5 6.5 0 0 0 9 9Z" />
          </svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M4.7 4.7l1.8 1.8M17.5 17.5l1.8 1.8M19.3 4.7l-1.8 1.8M6.5 17.5l-1.8 1.8" />
          </svg>
          <span class="sr">Toggle theme</span>
        </button>
      </nav>
      <main data-pagefind-body>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© 2026 Dustin Mooney</span>
        <a href="/rss.xml">RSS</a>
        <a href="mailto:dustin@dustinmooney.com">Email</a>
        <a href="https://linkedin.com/in/dustinmooney">LinkedIn</a>
      </footer>
    </div>

    <div id="search-overlay" hidden>
      <div class="search-backdrop" onclick="closeSearch()"></div>
      <div class="search-box" role="dialog" aria-modal="true" aria-label="Search the site">
        <input
          id="search-input"
          type="search"
          placeholder="Search writing, about, resume…"
          autocomplete="off"
          spellcheck="false"
        />
        <ol id="search-results"></ol>
        <p id="search-status" class="search-status"></p>
      </div>
    </div>
    <script is:inline>
      // Site search: Pagefind indexes the built site; this lazy-loads the
      // index on first open, so pages carry zero search JS until asked.
      let pagefind = null;
      let searchSeq = 0;

      function openSearch() {
        const overlay = document.getElementById('search-overlay');
        overlay.hidden = false;
        document.getElementById('search-input').focus();
      }
      function closeSearch() {
        document.getElementById('search-overlay').hidden = true;
        document.getElementById('search-input').blur();
      }

      addEventListener('keydown', (e) => {
        const overlay = document.getElementById('search-overlay');
        if (e.key === 'Escape' && !overlay.hidden) closeSearch();
        const typing = /^(INPUT|TEXTAREA)$/.test(document.activeElement?.tagName ?? '');
        if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key === 'k')) {
          e.preventDefault();
          overlay.hidden ? openSearch() : closeSearch();
        }
      });

      document.getElementById('search-input').addEventListener('input', async (e) => {
        const q = e.target.value.trim();
        const list = document.getElementById('search-results');
        const status = document.getElementById('search-status');
        const seq = ++searchSeq;
        if (!q) {
          list.innerHTML = '';
          status.textContent = '';
          return;
        }
        try {
          if (!pagefind) {
            pagefind = await import('/pagefind/pagefind.js');
            await pagefind.init();
          }
        } catch {
          status.textContent = 'Search is being indexed — try again after the next publish.';
          return;
        }
        const res = await pagefind.debouncedSearch(q);
        if (!res || seq !== searchSeq) return; // superseded by newer keystrokes
        const hits = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
        if (seq !== searchSeq) return;
        list.innerHTML = hits
          .map(
            (h) =>
              `<li><a href="${h.url}"><strong>${h.meta?.title ?? h.url}</strong>` +
              `<span>${h.excerpt}</span></a></li>`
          )
          .join('');
        status.textContent = hits.length ? '' : `Nothing found for “${q}”.`;
      });
    </script>
  </body>
</html>
