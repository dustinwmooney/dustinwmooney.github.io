---
// Base layout: chrome + head for every page. SEO/JSON-LD props ride through.
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = 'Dustin Mooney — customer success and strategy leader. Writing on work, technology, and building things.',
  ogType = 'website',
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dustin Mooney',
  url: 'https://dustinwmooney.github.io',
  sameAs: ['https://linkedin.com/in/dustinmooney'],
  jobTitle: 'Solutions Strategist',
  worksFor: { '@type': 'Organization', name: 'General Motors' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Dustin Mooney — Writing" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? person)} />
  </head>
  <body>
    <div class="wrap">
      <nav class="site-nav">
        <a class="brand" href="/">Dustin Mooney</a>
        <a href="/writing/" aria-current={Astro.url.pathname.startsWith('/writing') ? 'page' : undefined}>Writing</a>
        <a href="/resume/" aria-current={Astro.url.pathname.startsWith('/resume') ? 'page' : undefined}>Resume</a>
      </nav>
      <slot />
      <footer class="site-footer">
        <span>© 2026 Dustin Mooney</span>
        <a href="/rss.xml">RSS</a>
        <a href="mailto:dustin@mooney.me">Email</a>
        <a href="https://linkedin.com/in/dustinmooney">LinkedIn</a>
      </footer>
    </div>
  </body>
</html>
