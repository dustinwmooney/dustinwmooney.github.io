---
// About — Stamatiou-style: big hello, and the dither lab: the portrait run
// through real ordered-dithering (Bayer) or error diffusion on a canvas,
// with switchable two-tone palettes and a settings popover (type, matrix,
// dither amount, pixel size, exposure). Body copy is LOREM IPSUM until
// Dustin writes the real thing.
import Base from '../layouts/Base.astro';
---

<Base title="About — Dustin Mooney" description="About Dustin Mooney.">
  <section style="margin-top: 4rem;">
    <h1>Hello</h1>
    <p class="meta" style="font-size: 1.15rem; margin-top: 0.5rem;">
      I'm Dustin Mooney.
    </p>
  </section>

  <figure class="lab" id="lab">
    <div class="stage">
      <img id="labSrc" src="/images/about-nyc.jpg" alt="Dustin Mooney at Top of the Rock, New York City, with the Empire State Building behind" crossorigin="anonymous" />
      <canvas id="labCanvas" aria-hidden="true"></canvas>
      <div class="panel" id="labPanel" hidden>
        <div class="row"><span>Type</span>
          <span class="opts" data-k="type">
            <button data-v="bayer" class="on">Bayer</button>
            <button data-v="diffusion">Error Diffusion</button>
          </span>
        </div>
        <div class="row"><span>Bayer Matrix</span>
          <span class="opts" data-k="matrix">
            <button data-v="4" class="on">4×4</button>
            <button data-v="8">8×8</button>
          </span>
        </div>
        <div class="row"><span>Dither</span><input type="range" data-k="dither" min="0" max="100" value="80" /></div>
        <div class="row"><span>Pixel Size</span><input type="range" data-k="px" min="1" max="8" value="2" /></div>
        <div class="row"><span>Exposure</span><input type="range" data-k="exposure" min="-60" max="60" value="15" /></div>
      </div>
      <div class="bar">
        <span class="chips" id="labChips"></span>
        <span class="pname" id="labName"></span>
        <button class="gear" id="labGear" title="Dither settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h.09a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v.09a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1Z"/></svg>
        </button>
      </div>
    </div>
    <figcaption><span class="meta">Top of the Rock, New York City.</span></figcaption>
  </figure>

  <div class="prose" style="margin-top: 1.5rem;">
    <p><em>(Placeholder copy — the real bio is on its way.)</em></p>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere
    erat a ante venenatis dapibus posuere velit aliquet. Cras justo odio,
    dapibus ac facilisis in, egestas eget quam. Donec ullamcorper nulla non
    metus auctor fringilla, sed posuere consectetur est at lobortis.</p>
    <h2>Now</h2>
    <p>Vestibulum id ligula porta felis euismod semper. Maecenas faucibus
    mollis interdum. Aenean lacinia bibendum nulla sed consectetur. Nullam quis
    risus eget urna mollis ornare vel eu leo.</p>
    <h2>Before</h2>
    <p>Cum sociis natoque penatibus et magnis dis parturient montes, nascetur
    ridiculus mus. Duis mollis, est non commodo luctus, nisi erat porttitor
    ligula, eget lacinia odio sem nec elit. Sed posuere consectetur est at
    lobortis.</p>
    <h2>Elsewhere</h2>
    <p>Find me by <a href="mailto:dustin@dustinmooney.com">email</a>, on
    <a href="https://linkedin.com/in/dustinmooney">LinkedIn</a>, or subscribe to
    the <a href="/rss.xml">RSS feed</a>.</p>
  </div>
</Base>

<style>
  .lab { margin: 2.2rem 0 0; }
  .stage { position: relative; border-radius: 14px; overflow: hidden; }
  .stage img { display: block; width: 100%; border-radius: 0; }
  .stage canvas {
    display: block; width: 100%; position: absolute; inset: 0; height: 100%;
    image-rendering: pixelated;
  }
  .stage.original canvas { display: none; }

  .bar {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; gap: 0.8rem;
    padding: 0.7rem 0.9rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.35));
  }
  .chips { display: flex; gap: 0.45rem; }
  .chips :global(button) {
    width: 22px; height: 22px; border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.75);
    cursor: pointer; padding: 0; font-size: 0.75rem; line-height: 1;
    color: #fff; background: var(--s);
  }
  .chips :global(button:hover) { transform: scale(1.15); }
  .chips :global(button.on) { border-color: #fff; box-shadow: 0 0 0 2px rgba(255,255,255,.35); }
  .pname {
    font-family: var(--mono); font-size: 0.85rem; color: #fff;
    text-shadow: 0 1px 3px rgba(0,0,0,.6);
  }
  .gear {
    margin-left: auto; background: rgba(0,0,0,.3); border: none; cursor: pointer;
    width: 34px; height: 34px; border-radius: 50%; color: #fff; display: grid; place-items: center;
  }
  .gear svg { width: 19px; height: 19px; }
  .gear:hover { background: rgba(0,0,0,.5); }

  .panel[hidden] { display: none; }
  .panel {
    position: absolute; right: 0.9rem; bottom: 3.4rem;
    background: var(--bg); color: var(--text);
    border: 1px solid var(--rule); border-radius: 14px;
    padding: 1rem 1.1rem; display: grid; gap: 0.65rem;
    font-family: var(--mono); font-size: 0.85rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    min-width: 300px; max-width: calc(100% - 1.8rem);
  }
  .row { display: grid; grid-template-columns: 92px 1fr; align-items: center; gap: 0.7rem; }
  .opts { display: flex; gap: 0.9rem; }
  .opts button {
    background: none; border: none; padding: 0; cursor: pointer;
    color: var(--text-dim); font: inherit;
  }
  .opts button.on { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .panel input[type='range'] { width: 100%; accent-color: var(--accent); }
</style>

<script>
  // ── The dither lab ─────────────────────────────────────────────────────────
  const img = document.getElementById('labSrc') as HTMLImageElement;
  const canvas = document.getElementById('labCanvas') as HTMLCanvasElement;
  const stage = canvas.closest('.stage') as HTMLElement;
  const panel = document.getElementById('labPanel') as HTMLElement;
  const chipsBox = document.getElementById('labChips') as HTMLElement;
  const nameEl = document.getElementById('labName') as HTMLElement;

  const PALETTES: { name: string; dark: string; light: string }[] = [
    { name: "Gameboy '89", dark: '#0f380f', light: '#9bc417' },
    { name: 'Blueprint', dark: '#0c1f52', light: '#8fb4ff' },
    { name: 'Rust Belt', dark: '#3a140a', light: '#e08a4e' },
    { name: 'Newsprint', dark: '#15151a', light: '#e6e2d6' },
    { name: 'Orchid', dark: '#2a0f45', light: '#c99af2' },
  ];

  const state = {
    palette: 0,
    original: false,
    type: 'bayer' as 'bayer' | 'diffusion',
    matrix: 4,
    dither: 80,
    px: 2,
    exposure: 15,
  };

  const BAYER4 = [
    [0, 8, 2, 10],
    [12, 4, 14, 6],
    [3, 11, 1, 9],
    [15, 7, 13, 5],
  ];
  // 8x8 derived from 4x4 (standard recursive construction)
  const BAYER8 = Array.from({ length: 8 }, (_, y) =>
    Array.from({ length: 8 }, (_, x) => 4 * BAYER4[y % 4][x % 4] + BAYER4[Math.floor(y / 4) * 2 + Math.floor(x / 4)][0] % 4)
  );

  function hexRgb(h: string): [number, number, number] {
    const n = parseInt(h.slice(1), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  function render() {
    if (!img.complete || !img.naturalWidth) return;
    // Working resolution: ~900px of detail divided by pixel size — px 1 is
    // near-photographic dither, px 8 is chunky 8-bit.
    const base = Math.min(img.naturalWidth, 900);
    const w = Math.max(48, Math.round(base / state.px));
    const h = Math.round(img.naturalHeight * (w / img.naturalWidth));
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    ctx.drawImage(img, 0, 0, w, h);
    const data = ctx.getImageData(0, 0, w, h);
    const p = data.data;
    const pal = PALETTES[state.palette];
    const dark = hexRgb(pal.dark);
    const light = hexRgb(pal.light);
    const amt = state.dither / 100;
    const expo = state.exposure / 100;
    const M = state.matrix === 4 ? BAYER4 : BAYER8;
    const msize = state.matrix;
    const mdiv = msize * msize;

    // luminance + exposure, into a float buffer
    const lum = new Float32Array(w * h);
    for (let i = 0; i < w * h; i++) {
      const r = p[i * 4], g = p[i * 4 + 1], b = p[i * 4 + 2];
      let v = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
      v = Math.min(1, Math.max(0, v * (1 + expo) + expo * 0.25));
      lum[i] = v;
    }

    if (state.type === 'bayer') {
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const i = y * w + x;
          const t = ((M[y % msize][x % msize] + 0.5) / mdiv - 0.5) * amt;
          const on = lum[i] + t > 0.5;
          const c = on ? light : dark;
          p[i * 4] = c[0]; p[i * 4 + 1] = c[1]; p[i * 4 + 2] = c[2]; p[i * 4 + 3] = 255;
        }
      }
    } else {
      // Floyd–Steinberg error diffusion; amt scales how much error propagates
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const i = y * w + x;
          const old = lum[i];
          const on = old > 0.5;
          const err = (old - (on ? 1 : 0)) * amt;
          if (x + 1 < w) lum[i + 1] += (err * 7) / 16;
          if (y + 1 < h) {
            if (x > 0) lum[i + w - 1] += (err * 3) / 16;
            lum[i + w] += (err * 5) / 16;
            if (x + 1 < w) lum[i + w + 1] += (err * 1) / 16;
          }
          const c = on ? light : dark;
          p[i * 4] = c[0]; p[i * 4 + 1] = c[1]; p[i * 4 + 2] = c[2]; p[i * 4 + 3] = 255;
        }
      }
    }
    ctx.putImageData(data, 0, 0);
  }

  // palette chips + original
  PALETTES.forEach((pal, idx) => {
    const b = document.createElement('button');
    b.style.setProperty('--s', `linear-gradient(135deg, ${pal.dark} 50%, ${pal.light} 50%)`);
    b.style.background = `linear-gradient(135deg, ${pal.dark} 50%, ${pal.light} 50%)`;
    b.title = pal.name;
    if (idx === 0) b.classList.add('on');
    b.addEventListener('click', () => {
      state.palette = idx;
      state.original = false;
      stage.classList.remove('original');
      chipsBox.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
      b.classList.add('on');
      nameEl.textContent = pal.name;
      render();
    });
    chipsBox.appendChild(b);
  });
  const orig = document.createElement('button');
  orig.textContent = '◯';
  orig.style.background = 'rgba(0,0,0,.25)';
  orig.title = 'Original photo';
  orig.addEventListener('click', () => {
    state.original = true;
    stage.classList.add('original');
    chipsBox.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
    orig.classList.add('on');
    nameEl.textContent = 'Original';
  });
  chipsBox.appendChild(orig);
  nameEl.textContent = PALETTES[0].name;

  // gear + controls
  document.getElementById('labGear')!.addEventListener('click', () => {
    panel.hidden = !panel.hidden;
  });
  panel.querySelectorAll<HTMLElement>('.opts').forEach((group) => {
    group.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        group.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
        b.classList.add('on');
        const k = group.dataset.k!;
        const v = b.dataset.v!;
        if (k === 'type') state.type = v as typeof state.type;
        if (k === 'matrix') state.matrix = parseInt(v);
        render();
      });
    });
  });
  panel.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((r) => {
    r.addEventListener('input', () => {
      const k = r.dataset.k!;
      if (k === 'dither') state.dither = +r.value;
      if (k === 'px') state.px = +r.value;
      if (k === 'exposure') state.exposure = +r.value;
      render();
    });
  });

  if (img.complete) render();
  else img.addEventListener('load', render);
</script>
