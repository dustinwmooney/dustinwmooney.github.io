---
import Base from '../layouts/Base.astro';

import { jobs, additional, skills } from "../data/resume";
---

<Base title="Resume — Dustin Mooney" description="Dustin Mooney — resume. Customer success and strategy leadership across SaaS, publishing, and automotive.">
  <section style="margin-top: 3.5rem;">
    <h1 style="text-align: center; letter-spacing: 0.02em;">DUSTIN MOONEY</h1>
    <p class="mono" style="text-align: center; margin: 0.35rem 0 0; font-size: 0.95rem; letter-spacing: 0.22em; color: var(--text-dim);">RESUME</p>
    <p class="meta" style="margin-top: 0.7rem;">
      Management · Customer Success · Sales · Communications · Open-Source Research &amp; Analysis
    </p>
    <p style="margin-top: 1.1rem; display: flex; gap: 0.7rem; flex-wrap: wrap; justify-content: center;">
      <a class="btn" href="/files/resume.pdf" download>Download PDF ↓</a>
      <a class="btn" href="https://www.linkedin.com/in/dustinmooney/">LinkedIn ↗</a>
    </p>
  </section>

  <hr />

  <section>
    <h2>Experience</h2>
    {jobs.map((j) => (
      <article style="margin: 2rem 0;">
        <h3>{j.role}</h3>
        <p class="meta" style="margin: 0.25rem 0 0.7rem;">
          {j.org} · {j.where} · {j.when}
        </p>
        <p>{j.intro}</p>
        <ul>
          {j.points.map((pt) => <li style="margin-bottom: 0.5rem;">{pt}</li>)}
        </ul>
      </article>
    ))}
  </section>

  <hr />

  <section>
    <h2>Education &amp; Certifications</h2>
    <p style="margin-top: 1rem;">
      <strong>B.A. Political Science</strong> — University of Central Florida, Orlando, FL (2013)
    </p>
    <ul>
      <li>Certified Open-Source Intelligence Professional, The McAfee Institute <span class="tag-pill">in progress</span></li>
      <li>Google Data Analytics, Google</li>
    </ul>
  </section>

  <hr />

  <section>
    <h2 id="additional">Additional Experience</h2>
    <ul class="post-list" style="margin-top: 0.6rem;">
      {additional.map((a) => (
        <li>
          <span class="title">{a.role}, {a.org} <span class="meta">— {a.where}</span></span>
          <time>{a.when}</time>
        </li>
      ))}
    </ul>
  </section>

  <hr />

  <section>
    <h2>Skills</h2>
    <p style="margin-top: 0.8rem;" class="meta">{skills}</p>
  </section>
</Base>
