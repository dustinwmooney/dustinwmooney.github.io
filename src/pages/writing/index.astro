---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Writing — Dustin Mooney" description="Essays, features, and pointers from Dustin Mooney." wide>
  <section style="margin-top: 3.5rem;">
    <h1>Writing</h1>
    <p class="meta" style="margin-top: 0.9rem; max-width: 44rem;">
      Essays on customer success, business strategy, and what it actually takes to put AI to work, with the
      occasional detour into whatever I'm reading or building. Longer pieces and features live here;
      <span class="external">links</span> point to things I've written or said elsewhere.
      Subscribe by <a href="/rss.xml">RSS</a>, or browse the <a href="/writing/archive/">full archive</a>.
    </p>
  </section>
  <div class="grid3" style="margin-top: 2.2rem;">
    {posts.map((p) => (
      <a class="card" href={p.data.type === 'link' ? p.data.link : `/writing/${p.id}/`}>
        <h3>{p.data.title}{p.data.type === 'feature' && <span class="tag-pill" style="margin-left: 0.5rem;">feature</span>}</h3>
        <p>{p.data.description}</p>
        <span class="mono when">{fmt(p.data.date)}{p.data.type === 'link' && ' ↗'}</span>
      </a>
    ))}
  </div>
  <Subscribe />
</Base>
